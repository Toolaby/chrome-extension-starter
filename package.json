{
  "name": "glance",
  "description": "Know any page at a glance: read time, words and the outline, with Markdown export and Focus mode on Pro.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt build && npx -y toolaby@latest pack .output/chrome-mv3 --out .output/glance.zip",
    "setup": "node scripts/setup.mjs",
    "check": "wxt prepare && tsc --noEmit && vitest run",
    "test": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "0.21.4"
  }
}
